<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LexRisk — Review Report</title>
  <meta name="description" content="Structured contract risk report generated by LexRisk.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <div class="app-container">
    <!-- Navbar -->
    <header class="navbar">
      <div class="nav-brand">
        <a href="/" class="brand-link">
          <span class="brand-name">LexRisk</span>
          <span class="brand-sep">/</span>
          <span class="brand-sub">Report</span>
        </a>
      </div>
      <div class="nav-actions">
        <a href="/" class="btn btn-secondary btn-sm">Upload New Document</a>
      </div>
    </header>

    <main class="page-body">
      <!-- Report Overview Banner -->
      <header class="report-overview">
        <div class="overview-header">
          <div>
            <div class="section-label">Analysis Result</div>
            <h1 class="page-title">Contract Review & Risk Audit</h1>
          </div>
          <div class="overview-meta">
            <span class="meta-tag">ID: <code><%= report.contract_id ? report.contract_id.slice(0, 8) : 'N/A' %></code></span>
            <span class="meta-tag"><%= new Date(report.generated_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
          </div>
        </div>

        <!-- Metric Summary Bar -->
        <div class="metric-row">
          <div class="metric-cell">
            <span class="metric-num"><%= report.total_clauses %></span>
            <span class="metric-label">Extracted Clauses</span>
          </div>
          <div class="metric-cell">
            <span class="metric-num <%= report.high_risk_count > 0 ? 'text-danger' : '' %>"><%= report.high_risk_count %></span>
            <span class="metric-label">High-Impact Provisions</span>
          </div>
          <div class="metric-cell">
            <span class="metric-num <%= report.faithfulness_flags > 0 ? 'text-warning' : '' %>"><%= report.faithfulness_flags %></span>
            <span class="metric-label">Flagged Summaries</span>
          </div>
          <div class="metric-cell">
            <span class="metric-num"><%= (report.clauses && report.clauses.length > 0) ? (report.clauses[0].risk_score * 100).toFixed(0) + '%' : '0%' %></span>
            <span class="metric-label">Peak Criticality</span>
          </div>
        </div>

        <!-- Risk Distribution Line -->
        <%
          const critical = report.clauses.filter(c => c.risk_score >= 0.80).length;
          const high = report.clauses.filter(c => c.risk_score >= 0.65 && c.risk_score < 0.80).length;
          const moderate = report.clauses.filter(c => c.risk_score >= 0.35 && c.risk_score < 0.65).length;
          const low = report.clauses.filter(c => c.risk_score < 0.35).length;
          const total = report.total_clauses || 1;
        %>
        <div class="dist-container">
          <div class="dist-header">
            <span class="dist-title">Risk Spectrum Breakdown</span>
            <div class="dist-legend">
              <span class="legend-item"><span class="legend-box crit-box"></span> Critical (<%= critical %>)</span>
              <span class="legend-item"><span class="legend-box high-box"></span> High (<%= high %>)</span>
              <span class="legend-item"><span class="legend-box mod-box"></span> Moderate (<%= moderate %>)</span>
              <span class="legend-item"><span class="legend-box low-box"></span> Low (<%= low %>)</span>
            </div>
          </div>
          <div class="dist-bar">
            <div class="dist-segment crit-fill" style="width: <%= (critical / total * 100).toFixed(1) %>%"></div>
            <div class="dist-segment high-fill" style="width: <%= (high / total * 100).toFixed(1) %>%"></div>
            <div class="dist-segment mod-fill" style="width: <%= (moderate / total * 100).toFixed(1) %>%"></div>
            <div class="dist-segment low-fill" style="width: <%= (low / total * 100).toFixed(1) %>%"></div>
          </div>
        </div>

        <!-- Download Action After Risk Spectrum Breakdown -->
        <div class="report-action-bar">
          <button type="button" class="btn btn-secondary btn-download" onclick="downloadTextReport()">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Download Audit Report (.txt)
          </button>
        </div>
      </header>

      <!-- Filter / Control Bar -->
      <section class="controls-bar">
        <div class="filter-group">
          <button class="filter-chip active" onclick="filterClauses('all', this)">All (<%= report.total_clauses %>)</button>
          <button class="filter-chip" onclick="filterClauses('critical', this)">Critical (<%= critical %>)</button>
          <button class="filter-chip" onclick="filterClauses('high', this)">High (<%= high %>)</button>
          <button class="filter-chip" onclick="filterClauses('flagged', this)">Flagged (<%= report.faithfulness_flags %>)</button>
        </div>
        <div class="search-wrap">
          <input type="text" class="input-search" id="clause-search" placeholder="Filter clauses..." oninput="searchClauses(this.value)">
        </div>
      </section>

      <!-- Clauses List -->
      <section class="clause-table-view" id="clauses-list">
        <% report.clauses.forEach((clause, index) => { %>
        <%
          let riskLabel, riskClass;
          if (clause.risk_score >= 0.80) { riskLabel = 'Critical'; riskClass = 'critical'; }
          else if (clause.risk_score >= 0.65) { riskLabel = 'High'; riskClass = 'high'; }
          else if (clause.risk_score >= 0.35) { riskLabel = 'Moderate'; riskClass = 'moderate'; }
          else { riskLabel = 'Low'; riskClass = 'low'; }

          const isFlagged = clause.summary && clause.summary.faithfulness_flag;
        %>
        <article 
          class="clause-row <%= riskClass %>" 
          data-risk-class="<%= riskClass %>"
          data-flagged="<%= isFlagged ? 'true' : 'false' %>"
        >
          <!-- Clause Header / Identifier -->
          <div class="clause-row-header">
            <div class="clause-identity">
              <span class="clause-index">#<%= String(index + 1).padStart(2, '0') %></span>
              <span class="clause-type-name"><%= clause.clause_type.replace(/_/g, ' ') %></span>
              <% if (isFlagged) { %>
              <span class="flag-badge">Low Faithfulness</span>
              <% } %>
            </div>

            <div class="risk-indicator">
              <div class="risk-meta">
                <span class="risk-label <%= riskClass %>"><%= riskLabel %> Risk</span>
                <span class="risk-score-val"><%= (clause.risk_score * 100).toFixed(0) %>%</span>
              </div>
            </div>
          </div>

          <!-- Original Clause Text (Editorial Style) -->
          <div class="clause-quote-wrap">
            <div class="quote-label">Contract Provision</div>
            <blockquote class="clause-quote">
              <%= clause.text %>
            </blockquote>
          </div>

          <!-- Structured Interpretation (Plain Language) -->
          <% if (clause.summary) { %>
          <div class="summary-matrix">
            <div class="matrix-cell">
              <span class="cell-label">Plain English</span>
              <p class="cell-text"><%= clause.summary.meaning || '—' %></p>
            </div>
            <div class="matrix-cell">
              <span class="cell-label">Obligated Party</span>
              <p class="cell-text"><%= clause.summary.obligor || '—' %></p>
            </div>
            <div class="matrix-cell">
              <span class="cell-label">Trigger Condition</span>
              <p class="cell-text"><%= clause.summary.trigger || '—' %></p>
            </div>
            <div class="matrix-cell">
              <span class="cell-label">Legal Consequence</span>
              <p class="cell-text"><%= clause.summary.consequence || '—' %></p>
            </div>
          </div>

          <% if (clause.summary.faithfulness_flag) { %>
          <div class="notice-flagged">
            <strong>Entailment Notice:</strong> This generated summary scored <%= (clause.summary.faithfulness_score * 100).toFixed(0) %>% in cross-encoder verification. Review the raw clause text directly before reliance.
          </div>
          <% } %>
          <% } %>

          <!-- Audit Metrics (Deviation & Rationale) -->
          <footer class="clause-audit-footer">
            <div class="audit-item rationale-item">
              <span class="audit-label">Scoring Logic:</span>
              <span class="audit-val"><%= clause.risk_rationale %></span>
            </div>
            <div class="audit-item deviation-item">
              <span class="audit-label">Corpus Anomaly:</span>
              <span class="audit-val font-mono"><%= (clause.deviation_score !== null && clause.deviation_score !== undefined) ? (clause.deviation_score * 100).toFixed(1) + '%' : 'Uncomputed (Phase 3)' %></span>
            </div>
          </footer>
        </article>
        <% }) %>
      </section>

      <% if (!report.clauses || report.clauses.length === 0) { %>
      <div class="empty-notice">
        <p>No valid contractual clauses were identified in this file.</p>
        <a href="/" class="btn btn-secondary">Upload a different contract</a>
      </div>
      <% } else { %>
      <!-- Bottom Download Section -->
      <div class="bottom-download-bar">
        <div class="bottom-download-info">
          <span class="bottom-download-title">Review Complete</span>
          <span class="bottom-download-desc">Export the complete clause audit, metrics, and risk rationales as a structured text file.</span>
        </div>
        <button type="button" class="btn btn-primary btn-download" onclick="downloadTextReport()">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Download Audit Report (.txt)
        </button>
      </div>
      <% } %>

      <!-- Hidden Report Payload for Client-side Formatted Export -->
      <script type="application/json" id="report-json-data">
        <%- JSON.stringify(report) %>
      </script>
    </main>

    <footer class="site-footer">
      <div class="footer-left">
        <span>LexRisk</span>
        <span class="footer-bullet">•</span>
        <span>Contract Review Engine</span>
      </div>
      <div class="footer-right">
        <a href="/" class="footer-link">New Review</a>
      </div>
    </footer>
  </div>

  <script src="/js/report.js"></script>
</body>
</html>
