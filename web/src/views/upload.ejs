<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LexRisk — Contract Risk Review</title>
  <meta name="description" content="Automated contract review, clause anomaly detection, and risk assessment grounded in legal precedent.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <!-- Staged Pipeline Loading Overlay -->
  <div id="loading-overlay" class="loading-overlay hidden" aria-live="polite" role="status">
    <div class="loading-box">
      <div class="loading-header">
        <span class="loading-title">Analyzing Contract</span>
        <span class="loading-status" id="loading-detail">Normalizing text boundaries...</span>
      </div>
      <div class="progress-line">
        <div class="progress-indeterminate"></div>
      </div>
      <div class="loading-steps">
        <div class="step-item active" id="step-1">
          <span class="step-dot"></span>
          <span class="step-text">Layout & clause chunking</span>
        </div>
        <div class="step-item" id="step-2">
          <span class="step-dot"></span>
          <span class="step-text">LLM structured extraction</span>
        </div>
        <div class="step-item" id="step-3">
          <span class="step-dot"></span>
          <span class="step-text">DeBERTa-v3 entailment audit</span>
        </div>
        <div class="step-item" id="step-4">
          <span class="step-dot"></span>
          <span class="step-text">Corpus anomaly calculation</span>
        </div>
      </div>
    </div>
  </div>

  <div class="app-container">
    <!-- Top Nav -->
    <header class="navbar">
      <div class="nav-brand">
        <a href="/" class="brand-link" aria-label="LexRisk Home">
          <span class="brand-name">LexRisk</span>
          <span class="brand-sep">/</span>
          <span class="brand-sub">Contract Review</span>
        </a>
      </div>
      <nav class="nav-meta">
        <span class="nav-item">Phase 3 Index Ready</span>
        <span class="nav-divider" aria-hidden="true"></span>
        <span class="nav-item">DeBERTa-v3 NLI Audit</span>
      </nav>
    </header>

    <!-- Main Content -->
    <main class="page-body">
      <div class="hero-section">
        <h1 class="page-title">Objective contract review grounded in corpus precedent.</h1>
        <p class="page-lead">
          Extract operative clauses, verify plain-language entailment with local NLI, and benchmark provisions against standard contract taxonomy.
        </p>
      </div>

      <% if (error) { %>
      <div class="banner banner-error" role="alert">
        <span class="banner-badge">Error</span>
        <span class="banner-text"><%= error %></span>
      </div>
      <% } %>

      <!-- Upload Interface -->
      <section class="upload-section">
        <form id="upload-form" action="/upload" method="POST" enctype="multipart/form-data">
          <div 
            id="drop-zone" 
            class="drop-area"
            tabindex="0"
            role="button"
            aria-label="Upload contract file (drag and drop or press enter)"
            ondragover="handleDragOver(event)" 
            ondragleave="handleDragLeave(event)"
            ondrop="handleDrop(event)"
            onclick="document.getElementById('contract-file').click()"
            onkeydown="if(event.key === 'Enter' || event.key === ' ') { event.preventDefault(); document.getElementById('contract-file').click(); }"
          >
            <div class="drop-content">
              <div class="drop-graphic" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <line x1="12" y1="18" x2="12" y2="12"/>
                  <line x1="9" y1="15" x2="15" y2="15"/>
                </svg>
              </div>
              <div class="drop-text-group">
                <div class="drop-primary" id="drop-title">Select contract file or drag and drop here</div>
                <div class="drop-secondary">Supported formats: PDF, DOCX, or TXT (up to 20 MB)</div>
              </div>
            </div>
          </div>

          <input 
            type="file" 
            id="contract-file" 
            name="contract" 
            accept=".pdf,.docx,.doc,.txt,text/plain" 
            style="display:none" 
            onchange="handleFileSelect(event)"
          >

          <div id="file-selected" class="file-panel hidden">
            <div class="file-info">
              <span class="file-badge" id="file-ext">TXT</span>
              <div class="file-details">
                <span id="file-name" class="file-name"></span>
                <span id="file-size" class="file-size"></span>
              </div>
            </div>
            <button type="button" onclick="clearFile()" class="btn-clear" aria-label="Remove selected file">Remove</button>
          </div>

          <div class="form-actions">
            <button type="submit" id="submit-btn" class="btn btn-primary" disabled>
              <span id="btn-text">Select a contract to review</span>
            </button>
          </div>
        </form>

        <div class="sample-trigger-row">
          <span class="sample-prompt">Want to test the pipeline immediately?</span>
          <button type="button" class="btn-sample" onclick="loadSampleContract()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
              <polyline points="13 2 13 9 20 9"></polyline>
            </svg>
            Load Sample Agreement (Delaware NDA)
          </button>
        </div>
      </section>

      <!-- System Architecture & Pipeline Methodology -->
      <section class="spec-section">
        <h2 class="spec-heading">Evaluation Methodology</h2>
        <div class="spec-grid">
          <div class="spec-card">
            <div class="spec-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <line x1="3" y1="9" x2="21" y2="9"/>
                <line x1="9" y1="21" x2="9" y2="9"/>
              </svg>
            </div>
            <h3 class="spec-title">Structural Extraction</h3>
            <p class="spec-desc">Identifies clauses across 13 standard taxonomies (Indemnity, Liability Cap, IP, Termination, etc.) while rigorously preserving verbatim contract spans.</p>
          </div>
          <div class="spec-card">
            <div class="spec-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </div>
            <h3 class="spec-title">Entailment Verification</h3>
            <p class="spec-desc">Summaries are decomposed into Obligor, Trigger, and Legal Consequence, then audited for premise entailment using a local DeBERTa-v3 cross-encoder.</p>
          </div>
          <div class="spec-card">
            <div class="spec-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="20" x2="18" y2="10"/>
                <line x1="12" y1="20" x2="12" y2="4"/>
                <line x1="6" y1="20" x2="6" y2="14"/>
              </svg>
            </div>
            <h3 class="spec-title">Corpus Deviation</h3>
            <p class="spec-desc">Provisions are embedded with all-mpnet-base-v2 and compared directly against peer distributions in CUAD & LEDGAR vector index spaces.</p>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-left">
        <span>LexRisk</span>
        <span class="footer-bullet" aria-hidden="true">•</span>
        <span>Contract Risk Review Engine</span>
      </div>
      <div class="footer-right">
        <span>Local NLI & Semantic Vector Index</span>
      </div>
    </footer>
  </div>

  <script src="/js/upload.js"></script>
</body>
</html>
